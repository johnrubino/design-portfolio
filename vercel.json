{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/board/:jobId((?!job$|jobs\\.json$)[^/]+)",
      "destination": "/board/job?jobId=:jobId"
    }
  ],
  "headers": [
    {
      "source": "/john-rubino-resume.pdf",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "inline; filename=\"john-rubino-resume.pdf\""
        },
        {
          "key": "Content-Type",
          "value": "application/pdf"
        }
      ]
    }
  ]
}
